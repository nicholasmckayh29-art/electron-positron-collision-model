# IBM Quantum Runtime
# Copy this file to .env and fill in values locally. .env is gitignored.
IBM_QUANTUM_TOKEN=
# Alternative name accepted by the backend (either token variable works).
IBM_API_KEY=
# Instance CRN from IBM Quantum Platform → Account (not the short name "QEC").
# Example: crn:v1:bluemix:public:quantum-computing:us-east:...
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Leave false for local statevector sampling. Set true only when you want to
# spend IBM Quantum runtime.
USE_REAL_BACKEND=false
# Optional: pin a system (e.g. ibm_torino). Leave empty to auto-pick.
IBM_BACKEND=
# Seconds to wait for IBM job completion (default 900)
IBM_RUNTIME_TIMEOUT=900
IBM_PROBE_TIMEOUT=45
QMC_SHOTS=1024
QMC_MASS_BINS=256

# Policy-adaptive multi-knob loop (mode=adaptive_snapshot)
QMC_ADAPTIVE_MAX_ITERATIONS=20
QMC_ADAPTIVE_EPSILON=0.00001
QMC_ADAPTIVE_MIN_SHOTS=1024
QMC_ADAPTIVE_MAX_SHOTS=65536
QMC_POLICY_MAX_SHOTS=65536
QMC_POLICY_MAX_BINS=256
QMC_POLICY_ALLOW_BACKEND_SWITCH=true
QMC_POLICY_ALLOW_SYMMETRY_TOGGLE=true
QMC_POLICY_MIN_GAIN=0.0005
QMC_POLICY_MAX_COST_PER_GAIN=120.0

# Local hardware-run databank (JSONL, for ML / pathway analysis)
QMC_DATABANK_ENABLED=true
# QMC_DATABANK_PATH=data/quantum_databank/hardware_runs.jsonl
